# Copy to .env (ignored by Git) and adjust. No real secret belongs in this file.
PORT=3001
DATABASE_URL=postgresql://cloudops:change-me@localhost:5432/cloudops?schema=public

# JWT: use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# CORS: the origin of the Next.js app
FRONTEND_URL=http://localhost:3000

# One metric sample per server per interval (availability is computed from it)
METRICS_INTERVAL_SECONDS=60

# First Admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Platform Admin

SEED_DEMO=false
SEED_DEMO_PASSWORD=change-me-too

# Optional: NestJS Observe (written by `npx @nestjs/observe link`)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
